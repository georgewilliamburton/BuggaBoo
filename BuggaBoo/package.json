{
  "name": "buggaboo-studio",
  "version": "1.0.0",
  "description": "BuggaBoo Studio - Animation Maker for Kids",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": ["animation", "drawing", "kids", "creative"],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.buggaboo.studio",
    "productName": "BuggaBoo Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!.git/**/*",
      "!*.md",
      "!scraped_pages/**/*",
      "!*.txt",
      "!*.html",
      "!scraper.php",
      "!readexternal.php"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BuggaBoo Studio"
    }
  }
}
